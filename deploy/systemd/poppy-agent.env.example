# Copy this file to /etc/poppy-agent/poppy-agent.env and replace placeholders.
# EnvironmentFile is not a shell script: use literal values and absolute paths.

ROBOT_MODE=unitree
POPPY_ROBOT_ID=replace-with-robot-uuid

UNITREE_NETWORK_INTERFACE=enp3s0
POPPY_ROBOT_MODEL=GO2
POPPY_ROBOT_EDITION=EDU
POPPY_ROBOT_FIRMWARE_VERSION=unknown
UNITREE_SDK_VERSION=unitree_sdk2_python

POPPY_SERVER_URL=http://127.0.0.1:8080
POPPY_AGENT_TOKEN=replace-with-agent-token

POPPY_AGENT_NAME=poppy-agent-go2-01
POPPY_AGENT_VERSION=0.1.0
POPPY_SDK_VERSION=unitree_sdk2_python
POPPY_AGENT_PLATFORM=ubuntu-x86_64

POPPY_HEARTBEAT_INTERVAL_SECONDS=30
POPPY_EXECUTION_POLL_INTERVAL_SECONDS=1
POPPY_SERVER_CONNECT_TIMEOUT_SECONDS=5
POPPY_SERVER_READ_TIMEOUT_SECONDS=10
POPPY_SERVER_MAX_RETRIES=1

CYCLONEDDS_HOME=/home/poppy/poppy/cyclonedds-core/install
CMAKE_PREFIX_PATH=/home/poppy/poppy/cyclonedds-core/install
LD_LIBRARY_PATH=/home/poppy/poppy/cyclonedds-core/install/lib:/home/poppy/poppy/cyclonedds-core/install/lib64
