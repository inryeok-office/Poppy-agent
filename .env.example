ROBOT_MODE=mock
POPPY_ROBOT_ID=mock-robot-local
POPPY_ENABLE_PHYSICAL_EXECUTION=false
POPPY_SERVER_URL=https://example.invalid
POPPY_AGENT_TOKEN=replace-with-local-secret
POPPY_AGENT_NAME=poppy-agent-local
POPPY_AGENT_VERSION=0.1.0
POPPY_SDK_VERSION=not-applicable
POPPY_AGENT_PLATFORM=development
POPPY_HEARTBEAT_INTERVAL_SECONDS=30
POPPY_EXECUTION_POLL_INTERVAL_SECONDS=1
POPPY_SERVER_CONNECT_TIMEOUT_SECONDS=5
POPPY_SERVER_READ_TIMEOUT_SECONDS=10
POPPY_SERVER_MAX_RETRIES=1
POPPY_SERVER_RECONNECT_INITIAL_DELAY_SECONDS=1
POPPY_SERVER_RECONNECT_MAX_DELAY_SECONDS=30
POPPY_RUNTIME_STATUS_PATH=
UNITREE_NETWORK_INTERFACE=
POPPY_ROBOT_MODEL=
POPPY_ROBOT_EDITION=
POPPY_ROBOT_FIRMWARE_VERSION=
UNITREE_SDK_VERSION=unitree_sdk2_python
POPPY_UNITREE_TELEMETRY_STALE_TIMEOUT_SECONDS=5.0

# Controlled TURN trial (docs/controlled-turn-trial.md). No defaults: every key is
# required when POPPY_ENABLE_PHYSICAL_EXECUTION=true, otherwise the Agent stays
# heartbeat-only and reports BLOCKED. Keep POPPY_ENABLE_PHYSICAL_EXECUTION=false
# until the operator starts the approved trial.
POPPY_PHYSICAL_TRIAL_MODE=
POPPY_PHYSICAL_TURN_RATE_DEG_PER_S=
POPPY_PHYSICAL_MAX_TURN_DEG_PER_COMMAND=
POPPY_PHYSICAL_MAX_TOTAL_TURN_DEG=
POPPY_PHYSICAL_MAX_TOTAL_SECONDS=
POPPY_PHYSICAL_MAX_COMMANDS=
POPPY_PHYSICAL_ALLOWED_COMMANDS=
POPPY_PHYSICAL_TURN_LEFT_YAW_SIGN=
POPPY_PHYSICAL_APPROVAL_REF=
